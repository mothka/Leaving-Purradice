{{/* Leaving Purradice
Simple text-based game to clear cats off an island 
trigger: regex \A
limit in dashboard to only one channel
*/}}

{{/* CCIDs */}}
{{$startgame := 1}}
{{$finishcc := 2}}
{{$actioncc := 3}}
{{$petcc := 4}}
{{$trap_feedcc := 5}}
{{$namecc := 6}}
{{$daycc := 7}}
{{$freecc := 8}}
{{$reactcc := 9}}

{{/* DBs */}}
{{$db := dbGet .Channel.ID "purradice"}}
{{$udb := dbGet .User.ID "purradice"}}

{{if hasPrefix .Message.Content "-startgame"}}
    {{if or (not $db) (hasPermissions .Permissions.ManageMessages)}}
        {{execCC $startgame nil 0 .Message.Content}}
    {{end}}
    {{return}}

{{else if $db}}
    {{$db = $db.Value}}
{{else}}
    {{return}}
{{end}}

{{$buff := 0}}
{{$dmg := 0}}
{{$days := toInt $db.days}}
{{$msgs := add 1 (toInt $db.msgs)}}
{{$db.Set "msgs" $msgs}}

{{$cats := toInt $db.cats}}
{{$icats := toInt $db.interested}}
{{$cats = max $cats 0 | toInt}}

{{$icats = min $icats $cats | toInt}}

{{$news := cslice}}

{{/* passage of time: 
100 messages or 30 minutes (1800 seconds) is a new day
every 4 days is 5 new cats
*/}}
{{$timeDays := div (sub currentTime.Unix (toInt $db.gamestart)) 1800}}
{{$msgDays := div $msgs 100}}
{{$total := add $timeDays $msgDays}}

{{if gt $total $days}}
    {{/* new day */}}
    {{$newcats := mult 5 (sub (div $total 4) (div $days 4))}}
    {{if ge $newcats 1}}
        {{$cats = add $cats $newcats}}
        {{$db.Set "cats" $cats}}
    {{end}}
    
    {{$days = $total}}
    {{$db.Set "days" $days}}

    {{$s := sdict
    "newcats" $newcats
    "total" $total
   }}
    {{range $k, $v := $db}}
        {{$s.Set $k $v}}
    {{end}}

    {{execCC $daycc nil 0 $s}}
{{end}}

{{$10m := add currentTime.Unix 600}}
{{/* user de/buff determination */}}
{{$udb_expiry := $10m}}
{{$status := ""}}
{{if $udb}}
    {{$udb_expiry = $udb.ExpiresAt.Unix}}
    {{$udb = $udb.Value}}
    {{$buff = or (toInt $udb.buff) 0}}
    {{$dmg = or (toInt $udb.dmg) 0}}
    {{$um := add 1 (toInt $udb.msgs)}}
    {{$udb.Set "msgs" $um}}

    {{/* de/buffs last 10 messages or 10 minutes, whichever's shorter */}}
    {{if gt $um 10}}
        {{dbDel .User.ID "purradice"}}
        {{$udb = sdict}}
    {{end}}

    {{if gt $buff $dmg}}
        {{$status = "You're feeling pretty lucky today."}}
    {{else if lt $buff $dmg}}
        {{$status = "You feel a little under the weather today."}}
    {{end}}

{{end}}

{{if not $udb}}
    {{if $status}}
        {{$status = "You feel normal again."}}
        {{if $buff}}
            {{$status = print $status " Which, compared to the last few minutes, seems worse. :pensive:"}}
        {{else if $dmg}}
            {{$status = print $status " Which, compared to the last few minutes, feels pretty great! 🥳"}}
        {{end}}
    {{end}}

    {{$udb = sdict
    "buff" 0
    "dmg" 0
    "msgs" 1
    "lastroll" 2
   }}

    {{$buff = 0}}
    {{$dmg = 0}}
    {{$udb_expiry = $10m}}
{{end}}

{{/* roll + modifiers */}}
{{$roll := randInt 1 101}}
{{$roll = add $buff $roll}}
{{$roll = sub $roll $dmg}}
{{if and (le $roll 1) (eq $udb.lastroll 1)}}
    {{/* prevent death spiral */}}
    {{$roll = 2}}
{{end}}
{{$udb.Set "lastroll" $roll}}

{{/* how many uninterested cats will be affected by actions */}}
{{$affected := 1}}
{{$available := sub $cats $icats}}{{/* cats able to become interested */}}
{{$available = max $available 0 | toInt}}

{{try}}
    {{$affected = randInt 1 (add 1 $available)}}
{{catch}}
    {{$affected = 1}}
{{end}}

{{/* how many interested cats are affected */}}
{{$int_affected := 1}}
{{if gt $icats 2}}
    {{$int_affected = randInt 1 (add 1 $icats)}}
{{else if not $icats}}
    {{$int_affected = 0}}
{{end}}


{{$swing := min 50 (mult 3 (max $int_affected $affected)) | toInt}}

{{/* criticals */}}
{{$crit := 0}}
{{if le $roll 1}}
    {{$roll = 1}}
    {{$dmg = min 50 (add $dmg $swing) | toInt}}
    {{$crit = 1}}

{{else if ge $roll 100}}
    {{$roll = 100}}
    {{$buff = min 50 (add $buff $swing) | toInt}}
    {{$udb.Set "buff" $buff}}
    {{$crit = 2}}
{{end}}

{{/* clean message */}}
{{$m := lower .Message.Content}}
{{$m = reReplace `[^\w\s]` $m ""}}

{{/* is this a command? */}}
{{$cmd := 0}}
{{$spent := 0}}
{{$cat := `\b(?:cats?|kitty|kitties|animals?|felines?|felidaes?|kittens?|\:cat\:|(\:.*\_?cat(\d+)?(\_.*)?)\:)\b`}}

{{/* find pronoun without regex */}}
{{$words := split $m " "}}

{{$pronouns := cslice
    "i" "im" "ill" "were" "we" "us" "our" "me"
}}

{{$first := index $words 0}}
{{$pronoun := in $pronouns $first}}

{{if and (eq $first "the") (gt (len $words) 1)}}
    {{if (in (cslice "chat" "group") (index $words 1))}}
        {{$pronoun = 1}}
    {{end}}
{{end}}

{{/* find cat words without regex */}}
{{$catWords := cslice
    "cat" "cats"
    "kitty" "kitties"
    "animal" "animals"
    "feline" "felines"
    "felidae" "felidaes"
    "kitten" "kittens"
}}

{{$hasCat := 0}}

{{range $word := $words}}
    {{if in $catWords $word}}
        {{$hasCat = 1}}
    {{end}}
{{end}}

{{if and $pronoun $hasCat}}
    {{$cmd = 1}}

    {{$last := index $words (sub (len $words) 1)}}

    {{if in $catWords $last}}
        {{$cmd = 2}}
    {{end}}
{{end}}


{{/* frequently reused phrases */}}
{{$atks := index ($o := cslice "bites" "scratches" "nips" "claws" "kicks" "hisses at" "glares at" "attacks") (randInt (len $o))}}

{{$attracts := index ($o := cslice "brings forth" "interests" "lures in" "catches the attention of" "attracts") (randInt (len $o))}}

{{$theyre_interested := print "They " (index ($o := cslice "walk forward" "stare at you" "watch" "wander nearby" "glance toward you" "circle the area" "look toward you" "tilt their heads" "flick their ear" "flick their tail" "sniff the air" "lick their chops" ) (randInt (len $o))) " with interest"}}

{{$disinterests := index ($o := cslice "disinterests" "bores" "repels" "deters" "frightens" "annoys" "disturbs" "frustrates" "angers") (randInt (len $o))}}

{{$leave := index ($o := cslice "slip away" "run off" "trot off" "walk away" "leave" "bolt off") (randInt (len $o))}}


{{/* perception check or help */}}
{{$look := 0}}

{{$lookWords := cslice
"look" "scan" "watch" "observe" "help" "discern" "status" "investigate" "investigation" "survival" "inventory" "equipment" "rules" "commands" "stats" "health" "hp" "explore" "search" "sneak" "stalk" "find" "gather"
}}

{{if or $pronoun (eq (len $words) 1 2)}}
    {{$padded := print " " $m " "}}

    {{range $words}}
        {{if in $lookWords .}}
            {{$look = 1}}
        {{end}}
    {{end}}


    {{if or
        (in $padded " how many ")
        (in $padded " check on ")
        (in $padded " wonder where ")
        (in $padded " perception check ")
        (in $padded " what to do ")
        (in $padded " take stock ")
    }}
        {{$look = 1}}
    {{end}}

    {{if $look}}
        {{$spent = 1}}
    {{end}}
{{end}}

{{/* name the cat */}}
{{$name := 0}}
{{if and $cmd (not $spent)}}
    {{if (reFind `\bname?(d|ing)?\b` $m)}}
        {{$spent = 1}}
        {{$name = 1}}
    {{end}}
{{end}}

{{/* trap/bait don't need cat */}}
{{if and $pronoun (not $cmd) (not $spent)}}
    {{if reFind `\b(traps?|bait(s|ed|ing)?|feed(s|ing)?|fed)\b` $m}}
        {{$cmd = 1}}
    {{end}}
{{end}}


{{$db.Set "cats" $cats}}
{{$db.Set "interested" $icats}}

{{$save := sdict
"db" $db 
"affected" $affected
"atks" $atks
"attracts" $attracts
"available" $available
"buff" $buff
"cat" $cat
"cats" $cats
"cid" .Channel.ID
"cmd" $cmd
"crit" $crit
"disinterests" $disinterests
"dmg" $dmg
"finishcc" $finishcc
"icats" $icats
"int_affected" $int_affected
"leave" $leave
"look" $look
"m" $m
"mid" .Message.ID
"news" $news
"roll" $roll
"status" $status
"swing" $swing
"ten" $10m
"theyre_interested" $theyre_interested
"udb" $udb
"udb_expiry" $udb_expiry
"uid" .User.ID
}}

{{/* route */}}
{{if $name}}
    {{execCC $namecc nil 0 $save}}
{{else if $spent}}
    {{execCC $finishcc nil 0 $save}}
{{else if not $cmd}}
    {{/* chatter */}}
    {{execCC $reactcc nil 0 $save}}
{{else}}
    {{$cid := .Channel.ID}}
    {{$key := print "ptmp" .Message.ID}}
    {{$r := 0}}
    {{execCC $actioncc nil 0 $save}}
    {{range $w := cslice 1 2 3}}
        {{sleep $w}}
        {{with dbGet $cid $key}}
            {{$r = .Value}}
        {{end}}

        {{if $r}}
            {{break}}
        {{end}}
    {{end}}

    {{if $r}}
        {{/* action -> cc. anything not listed goes to react */}}
        {{$next := sdict
            "4_pet" $petcc
            "trap" $trap_feedcc
            "feeding" $trap_feedcc
            "7_free" $freecc
        }}
        {{execCC (or ($next.Get $r.a) $reactcc) nil 0 $r}}
    {{end}}
{{end}}
